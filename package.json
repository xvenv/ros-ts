{
  "name": "@xvenv/ros-ts",
  "version": "0.1.1",
  "description": "Type-safe RouterOS native API client for Node.js",
  "keywords": [
    "api",
    "client",
    "mikrotik",
    "routeros",
    "routeros-api",
    "typescript"
  ],
  "homepage": "https://github.com/xvenv/ros-ts#readme",
  "bugs": {
    "url": "https://github.com/xvenv/ros-ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xvenv/ros-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:integration": "vp test run test/integration",
    "check": "vp check",
    "pack:check": "npm pack --dry-run",
    "prepare": "vp config",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "^1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
